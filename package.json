{
  "name": "molt",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "ENVFILE=.env.staging react-native run-android",
    "ios": "ENVFILE=.env.staging react-native run-ios",
    "build:Production": "ENVFILE=.env.production cd android && ./gradlew assembleProductionRelease",
    "build:Staging": "ENVFILE=.env.staging cd android && ./gradlew assembleStagingRelease",
    "build:debug": "ENVFILE=.env.staging cd android && ./gradlew assembleStagingDebug",
    "install:apk": "adb install -r android/app/build/outputs/apk/release/app-release.apk",
    "ios-clean-open": "rm -rf ~/Library/Developer/Xcode/DerivedData && cd ios && rm -rf Pods Podfile.lock MoltApp.xcworkspace && pod install --repo-update && cd .. && open ios/MoltApp.xcworkspace",
    "link-assets": "react-native-asset",
    "generate:android-icons": "node scripts/generate-android-icons.cjs",
    "generate:ios-icons": "node scripts/generate-ios-icons.cjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:strict": "eslint . --max-warnings 0",
    "start": "react-native start --reset-cache",
    "test": "jest",
    "prepare": "husky"
  },
  "dependencies": {
    "@callstack/liquid-glass": "^0.7.0",
    "@hookform/resolvers": "^5.2.2",
    "@react-native-firebase/app": "^23.8.6",
    "@react-native-google-signin/google-signin": "^16.1.1",
    "@react-native/new-app-screen": "0.83.1",
    "@react-navigation/bottom-tabs": "^7.1.0",
    "@react-navigation/native": "^7.1.0",
    "@react-navigation/native-stack": "^7.1.0",
    "@reduxjs/toolkit": "^2.11.2",
    "axios": "^1.13.5",
    "date-fns": "^4.1.0",
    "react": "19.2.0",
    "react-hook-form": "^7.71.1",
    "react-native": "0.83.1",
    "react-native-config": "^1.6.1",
    "react-native-gesture-handler": "^2.20.0",
    "react-native-reanimated": "^4.2.1",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-screens": "^4.8.0",
    "react-native-svg": "^15.15.3",
    "react-native-svg-transformer": "^1.5.3",
    "react-native-worklets": "^0.7.3",
    "react-redux": "^9.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/plugin-transform-export-namespace-from": "^7.27.1",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@react-native-community/cli": "^20.0.0",
    "@react-native-community/cli-platform-android": "^20.0.0",
    "@react-native-community/cli-platform-ios": "^20.0.0",
    "@react-native/babel-preset": "0.83.1",
    "@react-native/eslint-config": "0.83.1",
    "@react-native/metro-config": "0.83.1",
    "@react-native/typescript-config": "0.83.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^8.57.1",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-unused-imports": "^4.3.0",
    "husky": "^9.1.7",
    "jest": "^29.6.3",
    "lint-staged": "^15.2.10",
    "prettier": "2.8.8",
    "react-native-asset": "^2.0.0",
    "react-test-renderer": "19.2.0",
    "sharp": "^0.34.5",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "fast-xml-parser": ">=5.3.4"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,md}": [
      "prettier --write"
    ],
    "*.{ts,tsx}": [
      "eslint --fix"
    ]
  }
}
